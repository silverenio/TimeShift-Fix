#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
1 ICON "../art/logo.ico"
IDR_DLL RCDATA "../src/dinput8.dll"
IDR_LANG_RU RCDATA "lang_ru.bin"
IDR_LANG_UK RCDATA "lang_uk.bin"
1 RT_MANIFEST "installer.manifest"

IDD_MAIN DIALOGEX 0, 0, 260, 178
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TimeShift Fix 2.0"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Fixes startup crash on modern CPUs + driver warning.\nФікс запуску / Фикс запуска.", -1, 10, 8, 240, 20
    LTEXT "Game folder:", -1, 10, 32, 240, 9
    EDITTEXT IDC_PATH, 10, 42, 240, 12, ES_READONLY | ES_AUTOHSCROLL
    GROUPBOX "Game text language / Мова тексту / Язык текста", -1, 10, 62, 240, 58
    AUTORADIOBUTTON "English (original)", IDC_EN, 20, 74, 200, 11, WS_GROUP
    AUTORADIOBUTTON "Українська (українізатор)", IDC_UK, 20, 88, 200, 11
    AUTORADIOBUTTON "Русский (русификатор)", IDC_RU, 20, 102, 200, 11
    LTEXT "Voice-over stays in English.", -1, 10, 124, 240, 9
    LTEXT "", IDC_STATUS, 10, 136, 240, 9
    DEFPUSHBUTTON "Install / Встановити", IDOK, 10, 154, 90, 16
    PUSHBUTTON "Uninstall / Видалити", IDC_UNINSTALL, 106, 154, 84, 16
    PUSHBUTTON "Close", IDCANCEL, 196, 154, 54, 16
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "TimeShift Fix Installer"
      VALUE "ProductName", "TimeShift Fix"
      VALUE "FileVersion", "2.0"
      VALUE "ProductVersion", "2.0"
      VALUE "LegalCopyright", "MIT License - github.com/silverenio/TimeShift-Fix"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
